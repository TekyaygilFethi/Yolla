# ---- Yolla settings ------------------------------------------------------------
# Folder on THIS machine that receives the uploads.
#   Windows: C:/Users/you/Pictures/Yolla   (forward slashes)
#   macOS:   /Users/you/Pictures/Yolla
#   Linux:   /home/you/Pictures/Yolla  or  /srv/photos
YOLLA_DIR=./uploads

# Anyone who knows the URL can upload unless you set a token. Use a long random string.
UPLOAD_TOKEN=change-me

# Port on this machine (the container always listens on 8080 internally).
YOLLA_PORT=8080
# Set to 127.0.0.1 if a reverse proxy on this machine is the only thing that should reach Yolla.
YOLLA_BIND=0.0.0.0

# true -> files land in <folder>/2026/2026-09/... based on the photo's own date
GROUP_BY_DATE=false

# Upload chunk size in MB. Keep it under 100 if Cloudflare is in front (per-request limit on free plans).
CHUNK_MB=32

# Reject single files larger than this (MB). 0 = no limit.
MAX_UPLOAD_MB=0

# The one folder the phone can read (the "Receive" tab). Default: an Outbox folder inside YOLLA_DIR.
# Path inside the container. Set to "off" to disable the Receive tab.
SHARE_DIR=/data/Outbox

# The container runs as this user (unprivileged). On Linux, match the owner of YOLLA_DIR: `id -u` / `id -g`.
# Docker Desktop (Windows/macOS) handles permissions itself; leave the defaults.
PUID=1000
PGID=1000

# Prebuilt image (leave as is unless you publish your own fork)
# YOLLA_IMAGE=ghcr.io/tekyaygilfethi/yolla:latest

# ---- optional tunnels ----------------------------------------------------------
# Make `docker compose up -d` also start a tunnel: quick | cloudflare | ngrok
# COMPOSE_PROFILES=quick

# Cloudflare named tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# ngrok (https://dashboard.ngrok.com/get-started/your-authtoken); NGROK_DOMAIN is optional (free static domain)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
